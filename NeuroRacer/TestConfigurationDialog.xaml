<Window x:Class="NeuroRacer.TestConfigurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Test Configuration" Height="200" Width="270" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10">
        <Button Name="SelectScheduleButton" Content="Select Schedule File" Margin="0,0,0,10" Click="SelectScheduleButton_Click" Width="229" Height="40"/>
        <Button Name="SelectOutputButton" Content="Select Output CSV and Folder Test Name" Margin="0,0,0,10" Click="SelectOutputButton_Click" Width="229" Height="40"/>
        <Button Name="OkButton" Content="START" HorizontalAlignment="Center" Width="75" Click="OkButton_Click" Height="40" IsEnabled="False"/>
    </StackPanel>
</Window>

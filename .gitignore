# Visual Studio 2022 .gitignore for a WPF Application

### User-specific files ###
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

### Build results ###
[Bb]in/
[Oo]bj/
[Ll]og/
*.log

### Visual Studio 2022 cache and config directories ###
.vs/
.vscode/

### Backup, temporary, and auto-generated files ###
*.bak
*.tmp
*.temp

# Files generated by XAML compilation (WPF)
*.g.cs
*.g.i.cs
*.xaml.cs

### Debugger and profiling files ###
*.pdb
*.mdb

### Test Results ###
TestResults/

# ---------------------
# Python project settings
# ---------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script that bootstraps a pyinstaller build.
#  They are located in the build folder in the current project.
build/
dist/

# Pytest cache
.cache

# Virtual environment
.env
.venv
env/
venv/

# Editor-specific files (Python-focused)
.idea/
.vscode/

# End of .gitignore
